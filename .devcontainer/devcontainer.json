{
  "name": "LeilaoIA",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt",
  "postAttachCommand": "uvicorn leilaoia.main:app --host 0.0.0.0 --port 8000",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "LeilaoIA", "onAutoForward": "openBrowser", "visibility": "private" } }
}
